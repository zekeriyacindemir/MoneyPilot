# Copy to .env.production (git-ignored) and fill in. Generate secrets with: openssl rand -base64 48
POSTGRES_DB=moneypilot
POSTGRES_USER=moneypilot
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
REFRESH_TOKEN_HMAC_SECRET=

# Public HTTPS origins served by your reverse proxy.
WEB_ORIGIN=https://app.example.com
API_ORIGIN=https://api.example.com

# Reverse proxies in front of the API (1 for a single Caddy/Nginx).
TRUST_PROXY=1

# Optional SMTP for password recovery and notification emails (TLS required).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

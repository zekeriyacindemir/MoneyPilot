{
  "name": "@moneypilot/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "npm run test:e2e",
